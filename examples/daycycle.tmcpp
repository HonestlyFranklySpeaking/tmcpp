// A full day over the sea. Press play on t: the sun rises in the east (left),
// sets in the west (right), and the moon follows on the opposite side of the sky.

settings x [-12 : 12] y [-7 : 9]

class paint { fill 1 opacity 0 }            // solid colour, no outline
class glow  { #fa7e19 opacity 0 }
class wave  { #ffffff opacity 0.35 width 1.5 }

"A day over the sea: press play on t (hours, 0 to 24)"

folder "Clock" {
  t = 6.5  [0 : 24 : 0.05]  . play loop 40s
  a = pi * (t - 6) / 12                     // sun angle: 0 at 6:00, pi at 18:00
  P = (-10 cos(a), 8 sin(a))                // sun, moving left to right
  M = (10 cos(a), -8 sin(a))                // moon, opposite the sun
  d = min(1, max(0, 1.4 sin(a) + 0.2))      // daylight, with a short twilight
  g = max(0, 1 - 3 abs(sin(a)))             // horizon glow at dawn and dusk
  (-11.5, 8.3) . point 0 label "hour ${t}" right
}

folder "Sky" collapsed {
  y > -20  #6cb4ee .paint
  y < [0, 0.5 ... 4]  .glow fill 0.1*g                      // dawn and dusk haze
}

folder "Sun" collapsed {
  (x - P.x)^2 + (y - P.y)^2 < 5    .glow fill 0.25          // halo
  (x - P.x)^2 + (y - P.y)^2 < 1.7  .glow fill 1             // disc
}

folder "Land" collapsed {
  y < 1.6 + 1.1 sin(0.4x + 1) + 0.5 sin(1.3x)   #6042a6 .paint fill 0.55   // far ridge
  y < 0.3 + 3 exp(-(x - 7)^2 / 5)               #2b2140 .paint             // near peak
}

folder "Sea" collapsed {
  y < 0  #2d70b3 .paint
  ((x - P.x) / 1.6)^2 + ((y + 0.5) / 0.22)^2 < 1  .glow fill 0.6*g           // sun reflection
  ((x - P.x) / 0.9)^2 + ((y + 1.3) / 0.15)^2 < 1  .glow fill 0.4*g
  y = -1 + 0.08 sin(3x)        .wave
  y = -2.6 + 0.1 sin(2x + 1)   .wave
  y = -4.5 + 0.12 sin(1.5x)    .wave
}

folder "Night" collapsed {
  y > -20  #1b1b3a .paint fill 0.8*(1-d)^2                 // darkness over everything
  S = [1 ... 60]
  (0.4 mod(37S, 61) - 12, 2 + 0.12 mod(23S, 59))  #ffffff point 3 @{ points: @{ opacity: 1 - d } }   // stars
  (x - M.x)^2 + (y - M.y)^2 < {y > 0: 0.9, -1}  #ffffff .paint            // moon, only above the horizon
  ((x - M.x) / 0.7)^2 + ((y + 0.7) / 0.12)^2 < 1  #ffffff .paint fill 0.3*max(0,sin(-a))   // moon reflection
}
