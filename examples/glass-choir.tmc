settings @{ viewport: @{ xmin: -15, xmax: 15, ymin: -9, ymax: 9 }, degreeMode: false, showGrid: false, showXAxis: false, showYAxis: false, randomSeed: "544d432b2b010508968c7e58cfdf7382" };

folder "Dive controls" {
a = 4.03 @{ slider: @{ min: 0, max: 2 * pi, step: 0, playing: true, loopMode: "LOOP_FORWARD", period: 14000 } };
d = 0 @{ slider: @{ min: -1.5, max: 1.5, step: 0.05 } };
"a runs the dive. Move d to change the sub’s depth and the timing of each echo.";
};
folder "Geometry and echo timing" {
L = [0 ... 96]/96;
h = -1.15+d+0.13*sin(a);
p = 19*a/(2*pi);
E(u,v) = exp(-((sqrt((u+4.99)^2+(v-h)^2)-p)/0.85)^2);
j = 3.8+0.15*cos(a);
k = 2.5+0.18*sin(a);
b = 1+0.065*cos(2*a);
f(u,v) = j+2.75*b*v*cos(2*pi*u);
g(u,v) = k+0.27*v*cos(2*pi*u)+v*(2.05*max(0,sin(2*pi*u))^0.84-0.35*max(0,-sin(2*pi*u))*(1+0.28*cos(14*pi*u)));
} @{ collapsed: true };
