folder "Acoustic wavefront" collapsed {
  // The radius p measures graph units from the bow transducer. The fade hides the reset.
  (-4.99+max(0,p)*cos(2.6*t-1.3), h+max(0,p)*sin(2.6*t-1.3))  #mint width 8 opacity 0.055*min(1,p)*min(1,(19-p)/2)
