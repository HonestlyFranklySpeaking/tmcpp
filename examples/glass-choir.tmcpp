// THE GLASS CHOIR | An animated bathypelagic field study.
// Written by ChatGPT in TMC++. Palette via `color`, water bands as one list inequality.
// Open in TMC++. Play a to send a ping. Adjust d to trim the sub.
settings x [-15 : 15] y [-9 : 9] radians no-grid @{ showXAxis: false, showYAxis: false }
color water #092635
color deep #061823
color shale #123949
color basalt #0b2835
color ink #051823
color slate #204352
color litrock #355562
color snow #a3d7d5
color beam #b2e8c8
color brass #ea9b40
color honey #ffd588
color rust #a95532
color glass #367c87
color foam #c2fff0
color mint #6ce8cb
color aqua #45aeab
color iris #8883bc
color pearl #f2fff0
color coral #be7868
class wash { fill 1 opacity 0 }

folder "Dive controls" {
  a = 4.03 [0 : 2pi] . play loop 14s
  d = 0 [-1.5 : 1.5 : 0.05]
  "a runs the dive. Move d to change the sub’s depth and the timing of each echo."
}

folder "Geometry and echo timing" collapsed {
  L = [0 ... 96]/96
  h = -1.15+d+0.13*sin(a)
  p = 19*a/(2*pi)
  E(u,v) = exp(-((sqrt((u+4.99)^2+(v-h)^2)-p)/0.85)^2)
  j = 3.8+0.15*cos(a)
  k = 2.5+0.18*sin(a)
  b = 1+0.065*cos(2*a)
  f(u,v) = j+2.75*b*v*cos(2*pi*u)
  g(u,v) = k+0.27*v*cos(2*pi*u)+v*(2.05*max(0,sin(2*pi*u))^0.84-0.35*max(0,-sin(2*pi*u))*(1+0.28*cos(14*pi*u)))
}

