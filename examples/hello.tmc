settings @{
  randomSeed: "fea78fbfaa7ccad876b30c01f9008ff6",
  viewport: @{
    xmin: -10,
    xmax: 10,
    ymin: -6.552364864864865,
    ymax: 7.552364864864865,
  },
  showGrid: false,
  showXAxis: false,
  showYAxis: false,
}

"Hello world in TMC++: press play on s to write it again (Ctrl+Enter recompiles)"

s = 1 @{
  color: "#c74440",
  slider: @{
    playing: true,
    loopMode: "PLAY_ONCE",
    min: 0,
    max: 1,
    step: 0.001,
  },
}

folder "Font" {
  X_a =
    [-7, -7, -5, -2, -4, -4, -4, -1, -1, 2, 2, 5.5, 6.5, 7, 7, 6.5, 5.5, 5, 5, -7, -6.5, -6, -5.5, -3.5, -2.5, -2, -2, -2.5, -3.5, -4, -4, -1, -1, 0.5, 1, 1, 0.5, -0.2, 2, 2, 5, 5, 6.2, 7, 7, 6.2] @{
    color: "#2d70b3",
  }

  Y_a =
    [2.5, 4, 5.5, 5.5, 5.5, 2.5, 4, 5.5, 2.5, 5.5, 2.5, 2.5, 2.5, 3, 5, 5.5, 5.5, 5, 3, 0.5, -2.5, -0.7, -2.5, -2.5, -2.5, -2, 0, 0.5, 0.5, 0, -2, -2.5, 0.5, 0.5, 0, -0.5, -1, -1, 0.5, -2.5, -2.5, 0.5, 0.5, -0.3, -1.7, -2.5] @{
    color: "#388c46",
  }

  X_b =
    [-7, -5, -5, -4, -4, -2, -2.5, -1, 1, 2, 4, 6.5, 7, 7, 6.5, 5.5, 5, 5, 5.5, -6.5, -6, -5.5, -5, -2.5, -2, -2, -2.5, -3.5, -4, -4, -3.5, -1, 0.5, 1, 1, 0.5, -1, 1, 2, 4, 5, 6.2, 7, 7, 6.2, 5] @{
    color: "#fa7e19",
  }

  Y_b =
    [5.5, 4, 2.5, 5.5, 2.5, 2.5, 4, 2.5, 2.5, 2.5, 2.5, 2.5, 3, 5, 5.5, 5.5, 5, 3, 2.5, -2.5, -0.7, -2.5, 0.5, -2.5, -2, 0, 0.5, 0.5, 0, -2, -2.5, 0.5, 0.5, 0, -0.5, -1, -1, -2.5, -2.5, -2.5, 0.5, 0.5, -0.3, -1.7, -2.5, -2.5] @{
    color: "#6042a6",
  }

  I = [0 ... 45] @{ color: "#000000" }

  F = {46 * s - I > 0: min(1, 46 * s - I)} @{ color: "#c74440" }
} @{ collapsed: true }

(X_a + t * F * (X_b - X_a), Y_a + t * F * (Y_b - Y_a)) @{
  color: "#2d70b3",
  lines: @{ opacity: 0.9, width: 5 },
}

(-7 + 14 * t * s, -4 + 0.25 * sin(3 * (-7 + 14 * t * s))) @{
  color: "#2d70b3",
  lines: @{ opacity: 0.9, width: 3 },
}