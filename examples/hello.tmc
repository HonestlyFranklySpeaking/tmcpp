settings @{ viewport: @{ xmin: -10, xmax: 10, ymin: -6, ymax: 7 }, showGrid: false, showXAxis: false, showYAxis: false, randomSeed: "544d432b2b014d0f3178f97569e17086" };

"Hello world in TMC++: press play on s to write it again (Ctrl+Enter recompiles)";
s = 0 @{ slider: @{ min: 0, max: 1, step: 0.001, playing: true, loopMode: "PLAY_ONCE", period: 4000 } };
folder "Font" {
Xa = [-7, -7, -5, -2, -4, -4, -4, -1, -1, 2, 2, 5.5, 6.5, 7, 7, 6.5, 5.5, 5, 5, -7, -6.5, -6, -5.5, -3.5, -2.5, -2, -2, -2.5, -3.5, -4, -4, -1, -1, 0.5, 1, 1, 0.5, -0.2, 2, 2, 5, 5, 6.2, 7, 7, 6.2];
Ya = [2.5, 4, 5.5, 5.5, 5.5, 2.5, 4, 5.5, 2.5, 5.5, 2.5, 2.5, 2.5, 3, 5, 5.5, 5.5, 5, 3, 0.5, -2.5, -0.7, -2.5, -2.5, -2.5, -2, 0, 0.5, 0.5, 0, -2, -2.5, 0.5, 0.5, 0, -0.5, -1, -1, 0.5, -2.5, -2.5, 0.5, 0.5, -0.3, -1.7, -2.5];
Xb = [-7, -5, -5, -4, -4, -2, -2.5, -1, 1, 2, 4, 6.5, 7, 7, 6.5, 5.5, 5, 5, 5.5, -6.5, -6, -5.5, -5, -2.5, -2, -2, -2.5, -3.5, -4, -4, -3.5, -1, 0.5, 1, 1, 0.5, -1, 1, 2, 4, 5, 6.2, 7, 7, 6.2, 5];
Yb = [5.5, 4, 2.5, 5.5, 2.5, 2.5, 4, 2.5, 2.5, 2.5, 2.5, 2.5, 3, 5, 5.5, 5.5, 5, 3, 2.5, -2.5, -0.7, -2.5, 0.5, -2.5, -2, 0, 0.5, 0.5, 0, -2, -2.5, 0.5, 0.5, 0, -0.5, -1, -1, -2.5, -2.5, -2.5, 0.5, 0.5, -0.3, -1.7, -2.5, -2.5];
I = [0 ... 45];
F = {46 * s - I > 0: min(1, 46 * s - I)};
} @{ collapsed: true };
(Xa + t * F * (Xb - Xa), Ya + t * F * (Yb - Ya)) @{ color: "#2d70b3", lines: @{ width: 5 } };
(-7 + 14 * t * s, -4 + 0.25 * sin(3 * (-7 + 14 * t * s))) @{ color: "#2d70b3", lines: @{ width: 3 } };
