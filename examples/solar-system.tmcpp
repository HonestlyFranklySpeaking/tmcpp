"Made by ChatGPT-6.2 Sol Ultra.
Prompt: Use tmcpp mcp to draw a cool looking physics realistic interpritation of the solar system in 3d. Dont put akward captions around the piece, instead the whole space should be used to present this piece of artwork, allow for movement in all directions via raycasting and other techniques using sliders."

// SOLAR SYSTEM — a full-frame perspective study in TMC++.
// Camera controls live in the sidebar. The drawing itself has no text.
// Orbital positions are computed in AU. The display compresses orbital spacing
// and enlarges bodies so the inner planets remain visible alongside Neptune.
settings x [-18 : 18] y [-10.85 : 10.85] radians no-grid lock @{ showXAxis: false, showYAxis: false }

folder "Camera · orbit, fly, roll" collapsed {
  a_yaw = 160 [-180 : 180 : 1]
  a_elevation = 29 [-90 : 90 : 1]
  a_roll = -12 [-180 : 180 : 1]
  d_distance = 43 [3 : 115 : 0.1]
  f_target = 0 [0 : 9 : 1]
  x_truck = 0 [-50 : 50 : 0.2]
  y_pedestal = 0 [-50 : 50 : 0.2]
  z_dolly = 0 [-50 : 50 : 0.2]
}
folder "Time · press play on the year" collapsed {
  y_year = 2028.630 [1800 : 2050 : 0.002] . loop 300s
}
folder "Display scale" collapsed {
  s_spacing = 0.51 [0.51 : 1 : 0.01]
  s_radius = 1 [0.25 : 2 : 0.01]
}
// JPL Solar System Dynamics, approximate positions, Table 1.
// https://ssd.jpl.nasa.gov/planets/approx_pos.html
// Mercury through Neptune. Earth uses the Earth–Moon barycentre.
// Coordinates are heliocentric AU in the J2000 ecliptic, with +Z north.
// q is Julian years (365.25 days each) since J2000.0. Valid range: -200 to 50.

folder "Keplerian orbits" collapsed hidden {
  A_epoch = [0.38709927,0.72333566,1.00000261,1.52371034,5.20288700,9.53667594,19.18916464,30.06992276]
  A_rate = [0.00000037,0.00000390,0.00000562,0.00001847,-0.00011607,-0.00125060,-0.00196176,0.00026291]
  E_epoch = [0.20563593,0.00677672,0.01671123,0.09339410,0.04838624,0.05386179,0.04725744,0.00859048]
  E_rate = [0.00001906,-0.00004107,-0.00004392,0.00007882,-0.00013253,-0.00050991,-0.00004397,0.00005105]
  I_epoch = [7.00497902,3.39467605,-0.00001531,1.84969142,1.30439695,2.48599187,0.77263783,1.77004347]
  I_rate = [-0.00594749,-0.00078890,-0.01294668,-0.00813131,-0.00183714,0.00193609,-0.00242939,0.00035372]
  L_epoch = [252.25032350,181.97909950,100.46457166,-4.55343205,34.39644051,49.95424423,313.23810451,-55.12002969]
  L_rate = [149472.67411175,58517.81538729,35999.37244981,19140.30268499,3034.74612775,1222.49362201,428.48202785,218.45945325]
  W_epoch = [77.45779628,131.60246718,102.93768193,-23.94362959,14.72847983,92.59887831,170.95427630,44.96476227]
  W_rate = [0.16047689,0.00268329,0.32327364,0.44441088,0.21252668,-0.41897216,0.40805281,-0.32241464]
  N_epoch = [48.33076593,76.67984255,0,49.55953891,100.47390909,113.66242448,74.01692503,131.78422574]
  N_rate = [-0.12534081,-0.27769418,0,-0.29257343,0.20469106,-0.28867794,0.04240589,-0.00508664]

  // Use radians internally. The rates above are per century.
  A_orbit(q,j) = A_epoch[j] + A_rate[j]*q/100
  E_orbit(q,j) = E_epoch[j] + E_rate[j]*q/100
  I_orbit(q,j) = (I_epoch[j] + I_rate[j]*q/100)*pi/180
  N_orbit(q,j) = (N_epoch[j] + N_rate[j]*q/100)*pi/180
  W_orbit(q,j) = (W_epoch[j] - N_epoch[j] + (W_rate[j]-N_rate[j])*q/100)*pi/180
  M_orbit(q,j) = (mod(L_epoch[j] - W_epoch[j] + (L_rate[j]-W_rate[j])*q/100 + 180,360)-180)*pi/180

  // Invert M = u - e*sin(u) using three Newton steps.
  E_start(q,j) = M_orbit(q,j) + E_orbit(q,j)*sin(M_orbit(q,j))
  E_step(u,m,c) = u + (m-u+c*sin(u))/(1-c*cos(u))
  E_one(q,j) = E_step(E_start(q,j),M_orbit(q,j),E_orbit(q,j))
  E_two(q,j) = E_step(E_one(q,j),M_orbit(q,j),E_orbit(q,j))
  E_solve(q,j) = E_step(E_two(q,j),M_orbit(q,j),E_orbit(q,j))

  // Rotate from perihelion, tip the plane, then rotate about the ecliptic pole.
  V_x(u,q,j) = A_orbit(q,j)*(cos(u)-E_orbit(q,j))
  V_y(u,q,j) = A_orbit(q,j)*sqrt(1-E_orbit(q,j)^2)*sin(u)
  V_node(u,q,j) = V_x(u,q,j)*cos(W_orbit(q,j)) - V_y(u,q,j)*sin(W_orbit(q,j))
  V_perp(u,q,j) = V_x(u,q,j)*sin(W_orbit(q,j)) + V_y(u,q,j)*cos(W_orbit(q,j))
  H_x(u,q,j) = V_node(u,q,j)*cos(N_orbit(q,j)) - V_perp(u,q,j)*cos(I_orbit(q,j))*sin(N_orbit(q,j))
  H_y(u,q,j) = V_node(u,q,j)*sin(N_orbit(q,j)) + V_perp(u,q,j)*cos(I_orbit(q,j))*cos(N_orbit(q,j))
  H_z(u,q,j) = V_perp(u,q,j)*sin(I_orbit(q,j))

  // Scalar functions H_*(u,q,j) are also available for individual orbit traces.
  Q_x(u,q) = [H_x(u,q,j) for j=[1...8]]
  Q_y(u,q) = [H_y(u,q,j) for j=[1...8]]
  Q_z(u,q) = [H_z(u,q,j) for j=[1...8]]
  P_x(q) = [H_x(E_solve(q,j),q,j) for j=[1...8]]
  P_y(q) = [H_y(E_solve(q,j),q,j) for j=[1...8]]
  P_z(q) = [H_z(E_solve(q,j),q,j) for j=[1...8]]
  O_x(u) = Q_x(u,0)
  O_y(u) = Q_y(u,0)
  O_z(u) = Q_z(u,0)
}
// Static celestial background. Prepend before orbital curves and planets.
class backgroundPaint { fill 1 opacity 0 }
class backgroundHaze { opacity 0 }

folder "Deep field" collapsed {
  // Widescreen coordinates for the sky wash and a diagonal galactic dust lane.
  b_u(x,y) = 0.914*x - 0.406*y
  b_v(x,y) = 0.406*x + 0.914*y - 1.4
  b_n(x,y) = b_v(x,y) - 0.7*sin(b_u(x,y)/6)
  b_f(x,y) = ((b_u(x,y)+4)/32)^2 + (b_n(x,y)/5.5)^2
  b_g(x,y) = ((b_u(x,y)+11)/19)^2 + ((b_n(x,y)-0.85)/2.7)^2
  b_h(x,y) = ((b_u(x,y)-11)/18)^2 + ((b_n(x,y)+1.2)/3.5)^2
  y > -100000 .backgroundPaint #050713
  b_f(x,y) < [1.9,1.7...0.1] .backgroundHaze #34477c fill 0.025
  b_g(x,y) < [1.6,1.45...0.1] .backgroundHaze #594878 fill 0.022
  b_h(x,y) < [1.6,1.45...0.1] .backgroundHaze #2c486b fill 0.025
  ((b_u(x,y)+2)/23)^2 + ((b_n(x,y)-0.2)/0.9)^2 < [1.4,1.1...0.2] .backgroundHaze #050612 fill 0.036

  // Deterministic pseudorandom angular locations. Three draws taper the dust.
  b_p(i,s) = mod(sin(i*(12.9898 + 0.481*s) + 78.233*s)*43758.5453,1)
  b_i = [1...1150]
  b_j = [1...425]
  b_k = [1...42]
  b_x = 68*b_p(b_i,1) - 34
  b_y = 40*b_p(b_i,2) - 20
  b_d = 51*b_p(b_j,3) - 25.5
  b_e = 5.2*(b_p(b_j,4)+b_p(b_j,5)+b_p(b_j,6)-1.5) + 0.7*sin(b_d/6) + 1.4
  b_m = (0.914*b_d + 0.406*b_e, -0.406*b_d + 0.914*b_e) . hidden
  (b_x,b_y) #a0b6e8 point 1.65 point-opacity 0.37
  b_m #9991cf point 1.4 point-opacity 0.25
  (68*b_p(b_k,7)-34,40*b_p(b_k,8)-20) #cfddff point 2.65 point-opacity 0.75
  (68*b_p(b_k,9)-34,40*b_p(b_k,10)-20) #f4c396 point 1.95 point-opacity 0.61

  // A few faint diffraction spikes outside the main subject.
  b_c = [-14.2,13.9,-11.6,11.7]
  b_l = [6.65,5.75,-6.45,-7.0]
  b_s = [0.21,0.26,0.17,0.15]
  (b_c,b_l) #84a6f0 point 11 point-opacity 0.08
  (b_c+1.25*b_s*(2*t-1),b_l) #bad8ff width 1 opacity 0.28
  (b_c,b_l+b_s*(2*t-1)) #bad8ff width 1 opacity 0.31
  (b_c,b_l) #e4efff point 4.2 point-opacity 0.88
}

folder "Scene geometry" collapsed hidden {
  // Right-handed display coordinates: JPL (x,y,z) becomes (x,z,-y).
  // Hold an orbit's scale constant through its year, preserving the ellipse.
  q_date = y_year-2000
  W_scale(a) = 14.55/30.0699*(a/30.0699)^(s_spacing-1)
  W_s = W_scale([A_orbit(q_date,j) for j=[1...8]])
  M_phase = mod(q_date*365.25/27.321661+0.34,1)*2pi
  M_size = 0.57
  W_px = W_s*P_x(q_date)
  W_py = W_s*P_z(q_date)
  W_pz = -W_s*P_y(q_date)
  W_x = join([0],W_px,[W_px[3]+M_size*cos(M_phase)])
  W_y = join([0],W_py,[W_py[3]+M_size*sin(M_phase)*sin(5.145*pi/180)])
  W_z = join([0],W_pz,[W_pz[3]-M_size*sin(M_phase)*cos(5.145*pi/180)])

  // Enlarged display radii are a monotone mapping of physical body radii.
  // The Moon is placed on a small illustrative circular orbit around Earth.
  R_km = [695700,2439.4,6051.8,6371.0084,3389.5,69911,58232,25362,24622,1737.4]
  R_body = s_radius*0.238*(R_km/6371.0084)^0.36

  // Saturn's IAU pole in the J2000 ecliptic display frame.
  // https://nssdc.gsfc.nasa.gov/planetary/factsheet/saturnfact.html
  S_ra = (40.589-0.036*q_date/100)*pi/180
  S_dec = (83.537-0.004*q_date/100)*pi/180
  S_eps = 23.43928*pi/180
  S_px = cos(S_dec)*cos(S_ra)
  S_py = sin(S_dec)*cos(S_eps)-cos(S_dec)*sin(S_ra)*sin(S_eps)
  S_pz = -cos(S_dec)*sin(S_ra)*cos(S_eps)-sin(S_dec)*sin(S_eps)
  S_tilt = sqrt(S_px^2+S_pz^2)

  // Camera rotation applied to vectors, then translation applied to points.
  // Truck/pedestal/dolly move in camera-local axes. Angles are in radians here.
  C_a = a_yaw*pi/180
  C_e = a_elevation*pi/180
  C_r = a_roll*pi/180
  C_d = d_distance+z_dolly
  C_f = 43
  C_fx = W_x[f_target+1]
  C_fy = W_y[f_target+1]
  C_fz = W_z[f_target+1]
  C_h(u,w) = u*cos(C_a)+w*sin(C_a)
  C_k(u,w) = w*cos(C_a)-u*sin(C_a)
  C_v(u,v,w) = v*cos(C_e)-C_k(u,w)*sin(C_e)
  C_right(u,v,w) = C_h(u,w)*cos(C_r)-C_v(u,v,w)*sin(C_r)
  C_up(u,v,w) = C_h(u,w)*sin(C_r)+C_v(u,v,w)*cos(C_r)
  C_forward(u,v,w) = -v*sin(C_e)-C_k(u,w)*cos(C_e)
  C_posx(u,v,w) = C_right(u-C_fx,v-C_fy,w-C_fz)-x_truck
  C_posy(u,v,w) = C_up(u-C_fx,v-C_fy,w-C_fz)-y_pedestal
  C_posz(u,v,w) = C_d+C_forward(u-C_fx,v-C_fy,w-C_fz)
  C_near(z) = {z>0.30: z}
  C_view(u,v,w) = C_f*(C_posx(u,v,w),C_posy(u,v,w))/C_near(C_posz(u,v,w))
  B_x = C_posx(W_x,W_y,W_z)
  B_y = C_posy(W_x,W_y,W_z)
  B_z = C_posz(W_x,W_y,W_z)
  B_d = sqrt(B_x^2+B_y^2+B_z^2)
  B_order = sort([1...10],-B_z)

  O_u(t,j) = W_s[j]*H_x(t,q_date,j)
  O_v(t,j) = W_s[j]*H_z(t,q_date,j)
  O_w(t,j) = -W_s[j]*H_y(t,q_date,j)
  O_plot(t,j) = C_view(O_u(t,j),O_v(t,j),O_w(t,j))
}

