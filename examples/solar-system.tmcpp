folder "Main belt" collapsed {
  // A stylized population distributed around the main belt, not tracked asteroids.
  A_i = [1...950]
  A_hash(i,s) = mod(sin(i*(13.679+0.67*s)+73.127*s)*43627.517,1)
  A_axis = 2.13+1.13*(A_hash(A_i,1)+A_hash(A_i,2))/2
  A_ang = 2pi*mod(A_hash(A_i,3)+q_date/A_axis^1.5,1)
  A_incl = 0.31*(A_hash(A_i,4)+A_hash(A_i,5)-1)
  A_node = 2pi*A_hash(A_i,6)
  A_rad = A_axis*W_scale(A_axis)*(1-0.08*A_hash(A_i,7)*cos(A_ang+5.6*A_hash(A_i,8)))
  A_vert = A_rad*sin(A_incl)*sin(A_ang)
  A_plane = A_rad*cos(A_ang)*cos(A_node)-A_rad*cos(A_incl)*sin(A_ang)*sin(A_node)
  A_cross = -A_rad*cos(A_ang)*sin(A_node)-A_rad*cos(A_incl)*sin(A_ang)*cos(A_node)
  C_view(A_plane,A_vert,A_cross) #8792b5 point 1.55 point-opacity 0.38
  C_view(A_plane[1...135],A_vert[1...135],A_cross[1...135]) #d0b8a2 point 2.05 point-opacity 0.38
}

folder "Solar corona" collapsed {
  G_x = C_f*B_x[1]/C_near(B_z[1])
  G_y = C_f*B_y[1]/C_near(B_z[1])
  G_r = C_f*R_body[1]/C_near(B_z[1])
  G_a(x,y) = arctan(y-G_y,x-G_x)
  G_w(x,y) = 1+0.035*sin(9*G_a(x,y)+0.7)+0.065*cos(3*G_a(x,y)-0.9)+0.028*sin(18*G_a(x,y))
  sqrt((x-G_x)^2+(y-G_y)^2) < G_r*[3.4,3.21...1.12]*G_w(x,y) #d95726 fill 0.028 opacity 0
  sqrt((x-G_x)^2+(y-G_y)^2) < G_r*[2.22,2.12...1.02]*G_w(x,y) #f18532 fill 0.058 opacity 0
  sqrt((x-G_x)^2+(y-G_y)^2) < G_r*[1.35,1.31...0.99]*G_w(x,y) #ffa850 fill 0.09 opacity 0
}

folder "Perspective rays and materials" collapsed hidden {
  // An orthonormal basis around the center ray to each body.
  D_x(i) = B_x[i]/B_d[i]
  D_y(i) = B_y[i]/B_d[i]
  D_z(i) = B_z[i]/B_d[i]
  D_g(i) = max(0.000001,sqrt(D_x(i)^2+D_z(i)^2))
  U_x(i) = D_z(i)/D_g(i)
  U_z(i) = -D_x(i)/D_g(i)
  V_rx(i) = -D_y(i)*D_x(i)/D_g(i)
  V_ry(i) = D_g(i)
  V_rz(i) = -D_y(i)*D_z(i)/D_g(i)

  // Shoot a unit ray in the tangent cone. At rho=1 it touches the silhouette.
  F_h(i,r) = r*R_body[i]/B_d[i]
  F_k(i,r) = sqrt(max(0,1-F_h(i,r)^2))
  F_x(i,r,a) = F_k(i,r)*D_x(i)+F_h(i,r)*(U_x(i)*cos(a)+V_rx(i)*sin(a))
  F_y(i,r,a) = F_k(i,r)*D_y(i)+F_h(i,r)*V_ry(i)*sin(a)
  F_z(i,r,a) = F_k(i,r)*D_z(i)+F_h(i,r)*(U_z(i)*cos(a)+V_rz(i)*sin(a))
  F_visible(i,z) = {B_z[i]>R_body[i]+0.30: {z>0.014: z}}
  F_screen(i,r,a) = C_f*(F_x(i,r,a),F_y(i,r,a))/F_visible(i,F_z(i,r,a))

  // Near ray/sphere intersection and the corresponding outward normal.
  S_hit(i,r) = B_d[i]*F_k(i,r)-R_body[i]*sqrt(max(0,1-r^2))
  S_x(i,r,a) = (S_hit(i,r)*F_x(i,r,a)-B_x[i])/R_body[i]
  S_y(i,r,a) = (S_hit(i,r)*F_y(i,r,a)-B_y[i])/R_body[i]
  S_z(i,r,a) = (S_hit(i,r)*F_z(i,r,a)-B_z[i])/R_body[i]
  S_dist(i) = max(0.000001,sqrt((B_x[i]-B_x[1])^2+(B_y[i]-B_y[1])^2+(B_z[i]-B_z[1])^2))
  S_light(i,x,y,z) = max(0,((B_x[1]-B_x[i])*x+(B_y[1]-B_y[i])*y+(B_z[1]-B_z[i])*z)/S_dist(i))
  S_limb(i,x,y,z) = max(0,-D_x(i)*x-D_y(i)*y-D_z(i)*z)

  T_lng(x,y,z) = x*C_right(1,0,0)+y*C_up(1,0,0)+z*C_forward(1,0,0)
  T_lat(x,y,z) = x*C_right(0,1,0)+y*C_up(0,1,0)+z*C_forward(0,1,0)
  T_phi(x,y,z) = x*C_right(0,0,1)+y*C_up(0,0,1)+z*C_forward(0,0,1)
  T_satlat(x,y,z) = x*C_right(S_px,S_py,S_pz)+y*C_up(S_px,S_py,S_pz)+z*C_forward(S_px,S_py,S_pz)
  T_pole(i,x,y,z) = {i=7: T_satlat(x,y,z),T_lat(x,y,z)}
  T_grain(p,l,w) = sin(27*p+13*l+8*w)*sin(19*l-15*w)*cos(31*w+14*p)
  T_land(p,l,w) = sin(4.6*p+2.4*l-0.4)+0.55*sin(10.2*w-2.8*l+2*p)+0.37*cos(11.8*l+5*w)+0.13*T_grain(p,l,w)
  T_continent(p,l,w) = max(0,min(1,3.5*(T_land(p,l,w)-0.48)))
  T_cloud(p,l,w) = 0.5*max(0,sin(19*l+8*w+2.1*sin(8*p-5*w))-0.46)
  T_bands(i,p,l,w) = {i=6: 0.19*sin(23*l+1.3*sin(6*p+5*w))+0.1*cos(67*l-0.5*sin(9*w)),i=7: 0.079*sin(32*l+0.35*p)+0.019*cos(49*l),i=3: 0.08*sin(20*l+6*p+4*w),i=8: 0.04*cos(22*l),i=9: 0.1*sin(15*l+1.4*w),i=1: 0.035*T_grain(p,l,w),0.10*T_grain(p,l,w)}
  T_baseR = [255,166,233,49,211,212,215,117,61,159]
  T_baseG = [206,154,182,100,108,156,184,199,115,158]
  T_baseB = [93,145,102,191,75,110,126,208,219,164]
  T_shade(i,x,y,z) = {i=1: 0.74+0.27*S_limb(i,x,y,z)^0.6,0.15+0.85*S_light(i,x,y,z)^0.58}
  T_red(i,p,l,w) = T_baseR[i]+{i=4: 56*T_continent(p,l,w)+111*T_cloud(p,l,w)+63*abs(l)^10,0}
  T_green(i,p,l,w) = T_baseG[i]+{i=1: 16*T_grain(p,l,w)+12*sin(8*p+9*l+3*w),i=4: 24*T_continent(p,l,w)+100*T_cloud(p,l,w)+79*abs(l)^10,0}
  T_blue(i,p,l,w) = T_baseB[i]+{i=1: 24*T_grain(p,l,w)+17*sin(8*p+9*l+3*w),i=4: -102*T_continent(p,l,w)+52*T_cloud(p,l,w)+46*abs(l)^10,0}
  T_brightness(i,x,y,z,p,l,w) = T_shade(i,x,y,z)*(1+T_bands(i,p,l,w))
  T_limit(v) = min(255,max(0,v))
  T_palette(i,x,y,z,p,l,w) = rgb(T_limit(T_red(i,p,l,w)*T_brightness(i,x,y,z,p,l,w)),T_limit(T_green(i,p,l,w)*T_brightness(i,x,y,z,p,l,w)),T_limit(T_blue(i,p,l,w)*T_brightness(i,x,y,z,p,l,w)))
  T_color(i,x,y,z) = T_palette(i,x,y,z,T_lng(x,y,z),T_pole(i,x,y,z),T_phi(x,y,z))
  T_sample(i,r,a) = T_color(i,S_x(i,r,a),S_y(i,r,a),S_z(i,r,a))

  // Concentric wedges use small overlaps to avoid antialiasing seams.
  // Increase detail only when a body occupies a large part of the image.
  J_detail(i) = C_f*R_body[i]/max(0.1,B_z[i])
  J_cols(i) = {J_detail(i)>0.72: 88,48}
  J_rows(i) = {J_detail(i)>0.72: 24,13}
  J_id(i) = [0...J_cols(i)*J_rows(i)-1]
  J_ring(i) = floor(J_id(i)/J_cols(i))
  J_wedge(i) = mod(J_id(i),J_cols(i))
  J_lo(i) = max(0,(J_ring(i)-0.075)/J_rows(i))
  J_hi(i) = min(1,(J_ring(i)+1.075)/J_rows(i))
  J_mid(i) = (J_ring(i)+0.5)/J_rows(i)
  J_start(i) = 2pi*(J_wedge(i)-0.055)/J_cols(i)
  J_end(i) = 2pi*(J_wedge(i)+1.055)/J_cols(i)
  J_angle(i) = 2pi*(J_wedge(i)+0.5)/J_cols(i)
  J_outline = 2pi*[0...119]/120
}

component Globe(rank) {
  body = B_order[rank]
  base = T_sample(body,0.8,0)
  tiles = T_sample(body,J_mid(body),J_angle(body))
  polygon(F_screen(body,1,J_outline)) . #(base) fill 1 opacity 0
  polygon(F_screen(body,J_lo(body),J_start(body)),F_screen(body,J_hi(body),J_start(body)),F_screen(body,J_hi(body),J_end(body)),F_screen(body,J_lo(body),J_end(body))) . #(tiles) fill 1 opacity 0
}

// Draw far bodies first. Recomputed as the view or planets move.
folder "Sun, planets and Moon" collapsed {
  new Globe(1)
  new Globe(2)
  new Globe(3)
  new Globe(4)
  new Globe(5)
  new Globe(6)
  new Globe(7)
  new Globe(8)
  new Globe(9)
  new Globe(10)
}

folder "Saturn's rings" collapsed {
  // Tilted ring plane, with a conspicuous gap between the bright main bands.
  K_u = -S_pz/S_tilt
  K_v = S_px/S_tilt
  K_x(t,r) = W_x[7]+R_body[7]*r*(K_u*cos(t)-K_v*S_py*sin(t))
  K_y(t,r) = W_y[7]+R_body[7]*r*S_tilt*sin(t)
  K_z(t,r) = W_z[7]+R_body[7]*r*(K_v*cos(t)+K_u*S_py*sin(t))
  K_a(t,r) = C_posx(K_x(t,r),K_y(t,r),K_z(t,r))
  K_b(t,r) = C_posy(K_x(t,r),K_y(t,r),K_z(t,r))
  K_c(t,r) = C_posz(K_x(t,r),K_y(t,r),K_z(t,r))
  // Reject hidden arcs when the view ray hits Saturn before it reaches the rings.
  K_l(t,r) = sqrt(K_a(t,r)^2+K_b(t,r)^2+K_c(t,r)^2)
  K_dot(t,r,i) = (K_a(t,r)*B_x[i]+K_b(t,r)*B_y[i]+K_c(t,r)*B_z[i])/max(0.001,K_l(t,r))
  K_disc(t,r,i) = K_dot(t,r,i)^2-B_d[i]^2+R_body[i]^2
  K_front(t,r,i) = K_dot(t,r,i)-sqrt(max(0,K_disc(t,r,i)))
  K_clear(t,r,i) = {K_disc(t,r,i)<0: 1,K_front(t,r,i)<=0: 1,K_front(t,r,i)>=K_l(t,r): 1,0}
  K_own(t,r) = {K_clear(t,r,7)>0: C_near(K_c(t,r))}
  K_plot(t,r) = C_f*(K_a(t,r),K_b(t,r))/K_own(t,r)
  // Trace a second ray toward the Sun to leave a shadow where Saturn blocks it.
  K_sundist(t,r) = sqrt(K_x(t,r)^2+K_y(t,r)^2+K_z(t,r)^2)
  K_tosun(t,r) = (K_x(t,r)*(K_x(t,r)-W_x[7])+K_y(t,r)*(K_y(t,r)-W_y[7])+K_z(t,r)*(K_z(t,r)-W_z[7]))/K_sundist(t,r)
  K_sunlit(t,r) = {K_tosun(t,r)<R_body[7]*sqrt(r^2-1): 1}
  K_bright(t,r) = K_plot(t,r)*K_sunlit(t,r)
  K_plot(t,[1.27,1.295...1.52]) #514747 width 1.05 opacity 0.53 @{ domain: @{ min: 0, max: 2*pi } }
  K_plot(t,[1.54,1.559...1.935]) #786b61 width 1.15 opacity 0.61 @{ domain: @{ min: 0, max: 2*pi } }
  K_plot(t,[2.03,2.047...2.28]) #675d57 width 0.96 opacity 0.58 @{ domain: @{ min: 0, max: 2*pi } }
  K_bright(t,[1.27,1.295...1.52]) #a08b77 width 1.05 opacity 0.54 @{ domain: @{ min: 0, max: 2*pi } }
  K_bright(t,[1.54,1.559...1.935]) #e5c394 width 1.15 opacity 0.63 @{ domain: @{ min: 0, max: 2*pi } }
  K_bright(t,[2.03,2.047...2.28]) #cbbb9d width 0.96 opacity 0.58 @{ domain: @{ min: 0, max: 2*pi } }
  K_bright(t,[2.30,2.33,2.35]) #968777 width 0.85 opacity 0.45 @{ domain: @{ min: 0, max: 2*pi } }
}
