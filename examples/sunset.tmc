settings @{ viewport: @{ xmin: -12, xmax: 12, ymin: -7, ymax: 9 } };

"Sunset over the sea: drag t to change the time of day";
folder "Controls" {
t = 0.3 @{ slider: @{ min: 0, max: 1, step: 0.01 } };
h = -1.5 + 9 * t;
(-11.5, 8.3) @{ points: @{ size: 0 }, label: @{ text: "time of day: t = ${t}", orientation: "right" } };
};
folder "Sky" {
y > -20 @{ color: "#6cb4ee", fill: 1, lines: @{ opacity: 0 } };
y < [0, 0.5 ... 4] @{ color: "#fa7e19", lines: @{ opacity: 0 }, fill: 0.07*(1-t) };
} @{ collapsed: true };
folder "Sun" {
x^2 + (y - h)^2 < 5 @{ color: "#fa7e19", lines: @{ opacity: 0 }, fill: 0.25 };
x^2 + (y - h)^2 < 1.7 @{ color: "#fa7e19", lines: @{ opacity: 0 }, fill: 1 };
} @{ collapsed: true };
folder "Land" {
y < 1.6 + 1.1 * sin(0.4 * x + 1) + 0.5 * sin(1.3 * x) @{ color: "#6042a6", fill: 0.55, lines: @{ opacity: 0 } };
y < 0.3 + 3 * exp(-(x - 7)^2 / 5) @{ color: "#2b2140", fill: 1, lines: @{ opacity: 0 } };
} @{ collapsed: true };
folder "Sea" {
y < 0 @{ color: "#2d70b3", fill: 1, lines: @{ opacity: 0 } };
((x / 1.6)^2 + ((y + 0.5) / 0.22)^2 < 1) @{ color: "#fa7e19", lines: @{ opacity: 0 }, fill: 0.6*(1-t) };
((x / 0.9)^2 + ((y + 1.3) / 0.15)^2 < 1) @{ color: "#fa7e19", lines: @{ opacity: 0 }, fill: 0.4*(1-t) };
y = -1 + 0.08 * sin(3 * x) @{ color: "#ffffff", lines: @{ opacity: 0.35, width: 1.5 } };
y = -2.6 + 0.1 * sin(2 * x + 1) @{ color: "#ffffff", lines: @{ opacity: 0.35, width: 1.5 } };
y = -4.5 + 0.12 * sin(1.5 * x) @{ color: "#ffffff", lines: @{ opacity: 0.35, width: 1.5 } };
} @{ collapsed: true };
folder "Night" {
y > -20 @{ color: "#1b1b3a", fill: 0.8*(1-t)^2, lines: @{ opacity: 0 } };
S = [1 ... 60];
(0.4 * mod(37 * S, 61) - 12, 2 + 0.12 * mod(23 * S, 59)) @{ color: "#ffffff", points: @{ size: 3, opacity: 1 - t } };
(x - 8)^2 + (y - 7)^2 < 0.9 @{ color: "#ffffff", fill: 1-t, lines: @{ opacity: 0 } };
} @{ collapsed: true };
