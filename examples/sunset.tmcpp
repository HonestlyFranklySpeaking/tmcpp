// Sunset over the sea. Drag t (or press play) to move from night to day.

settings x [-12 : 12] y [-7 : 9]

class paint { fill 1 opacity 0 }            // solid colour, no outline
class glow  { #fa7e19 opacity 0 }
class wave  { #ffffff opacity 0.35 width 1.5 }

"Sunset over the sea: drag t to change the time of day"

folder "Controls" {
  t = 0.3  [0 : 1 : 0.01]                   // 0 = night, 1 = midday
  h = -1.5 + 9t                             // sun height
  (-11.5, 8.3) . point 0 label "time of day: t = ${t}" right
}

folder "Sky" collapsed {
  y > -20  #6cb4ee .paint                                  // day sky
  y < [0, 0.5 ... 4]  .glow fill 0.07*(1-t)                // warm haze, stacked bands
}

folder "Sun" collapsed {
  x^2 + (y - h)^2 < 5    .glow fill 0.25                   // halo
  x^2 + (y - h)^2 < 1.7  .glow fill 1                      // disc
}

folder "Land" collapsed {
  y < 1.6 + 1.1 sin(0.4x + 1) + 0.5 sin(1.3x)   #6042a6 .paint fill 0.55   // far ridge
  y < 0.3 + 3 exp(-(x - 7)^2 / 5)               #2b2140 .paint             // near peak
}

folder "Sea" collapsed {
  y < 0  #2d70b3 .paint
  ((x / 1.6)^2 + ((y + 0.5) / 0.22)^2 < 1)  .glow fill 0.6*(1-t)          // sun reflection
  ((x / 0.9)^2 + ((y + 1.3) / 0.15)^2 < 1)  .glow fill 0.4*(1-t)
  y = -1 + 0.08 sin(3x)        .wave
  y = -2.6 + 0.1 sin(2x + 1)   .wave
  y = -4.5 + 0.12 sin(1.5x)    .wave
}

folder "Night" collapsed {
  y > -20  #1b1b3a .paint fill 0.8*(1-t)^2                 // darkness over everything
  S = [1 ... 60]
  (0.4 mod(37S, 61) - 12, 2 + 0.12 mod(23S, 59))  #ffffff point 3 @{ points: @{ opacity: 1 - t } }   // stars
  (x - 8)^2 + (y - 7)^2 < 0.9  #ffffff .paint fill 1-t     // moon
}
