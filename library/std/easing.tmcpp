// std/easing.tmcpp
// Animation easing curves, timeline windows, and interpolation helpers for TMC++

// ==========================================
// 1. CLAMPING & TIMELINE WINDOWS
// ==========================================

// Clamp t to [0, 1]
clamp01(t) = min(max(t, 0), 1)

// Remap t from [t0, t1] into [0, 1], clamped outside the window
// Essential for multi-stage animations driven by a single master slider
window(t, t0, t1) = clamp01((t - t0) / max(t1 - t0, 1e-6))

// Smooth Hermite interpolation between 0 and 1 over [edge0, edge1]
smoothstep(edge0, edge1, t) = u * u * (3 - 2 * u) with u = window(t, edge0, edge1)

// ==========================================
// 2. QUADRATIC & CUBIC EASING (t in)
// ==========================================

easeInQuad(t) = clamp01(t)^2
easeOutQuad(t) = 1 - (1 - clamp01(t))^2
easeInOutQuad(t) = {
  u < 0.5: 2 * u^2,
  1 - (-2 * u + 2)^2 / 2
} with u = clamp01(t)

easeInCubic(t) = clamp01(t)^3
easeOutCubic(t) = 1 - (1 - clamp01(t))^3
easeInOutCubic(t) = {
  u < 0.5: 4 * u^3,
  1 - (-2 * u + 2)^3 / 2
} with u = clamp01(t)

// ==========================================
// 3. QUARTIC, QUINTIC & EXPONENTIAL
// ==========================================

easeInQuart(t) = clamp01(t)^4
easeOutQuart(t) = 1 - (1 - clamp01(t))^4
easeInOutQuart(t) = {
  u < 0.5: 8 * u^4,
  1 - (-2 * u + 2)^4 / 2
} with u = clamp01(t)

easeInExpo(t) = {
  u <= 0: 0,
  2^(10 * u - 10)
} with u = clamp01(t)
easeOutExpo(t) = {
  u >= 1: 1,
  1 - 2^(-10 * u)
} with u = clamp01(t)

// ==========================================
// 4. OVERSHOOT (BACK), ELASTIC & BOUNCE
// ==========================================

// Slight pullback / overshoot (great for UI pop-ins)
easeOutBack(t) = (
  1 + 2.70158 * (u - 1)^3 + 1.70158 * (u - 1)^2
) with u = clamp01(t)

easeInOutBack(t) = {
  u < 0.5: ((2 * u)^2 * (3.5949095 * 2 * u - 2.5949095)) / 2,
  ((2 * u - 2)^2 * (3.5949095 * (2 * u - 2) + 2.5949095) + 2) / 2
} with u = clamp01(t)

// Springy elastic settle
easeOutElastic(t) = {
  u <= 0: 0,
  u >= 1: 1,
  2^(-10 * u) * sin((u * 10 - 0.75) * (2 * pi / 3)) + 1
} with u = clamp01(t)

// Bouncing ball settle
easeOutBounce(t) = {
  u < 1 / 2.75: 7.5625 * u^2,
  u < 2 / 2.75: 7.5625 * (u - 1.5 / 2.75)^2 + 0.75,
  u < 2.5 / 2.75: 7.5625 * (u - 2.25 / 2.75)^2 + 0.9375,
  7.5625 * (u - 2.625 / 2.75)^2 + 0.984375
} with u = clamp01(t)

// ==========================================
// 5. INTERPOLATION & LOOPING HELPERS
// ==========================================

// Linear interpolation (works on scalars, points (x, y), and lists!)
lerp(a, b, t) = a + (b - a) * t

// Smoothly oscillate 0 -> 1 -> 0 over t in [0, 1]
pingPong(t) = 1 - abs(2 * mod(t, 1) - 1)
