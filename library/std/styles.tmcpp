// std/styles.tmcpp
// Zero-cost color palettes and semantic style classes for TMC++

// ==========================================
// 1. CURATED COLOR PALETTE
// ==========================================

// Core UI & Neutrals
color ink       #1e293b
color slate     #64748b
color mist      #cbd5e1
color paper     #f8fafc
color obsidian  #0f172a

// Vivid Accents (harmonized & colorblind-friendly)
color coral     #e11d48
color amber     #d97706
color emerald   #059669
color sky       #0284c7
color indigo    #4f46e5
color violet    #7c3aed
color teal      #0d9488
color gold      #eab308

// ==========================================
// 2. CURVE & GRAPH ROLES
// ==========================================

// Primary plotted curves
class primary   { #sky width 3 }
class secondary { #coral width 2.5 }
class tertiary  { #emerald width 2.5 }
class accent    { #amber width 3 }

// Faint reference / construction lines
class guide     { #slate dashed width 1.5 opacity 0.45 }
class gridline  { #mist width 1 opacity 0.35 }
class axis      { #ink width 2 opacity 0.8 }
class asymptote { #coral dotted width 2 opacity 0.65 }

// Ghosted / previous-state / trailing paths
class ghost     { #slate dashed width 2 opacity 0.25 }
class trail     { #sky width 2 opacity 0.3 }
class bold      { width 4.5 }
class thin      { width 1.2 }

// ==========================================
// 3. REGIONS & FILLS
// ==========================================

class region    { #sky fill 0.18 width 2 }
class highlight { #amber fill 0.25 width 2 }
class danger    { #coral fill 0.2 width 2 }
class success   { #emerald fill 0.2 width 2 }
class solid-fill { fill 1 width 0 }
class soft-fill  { fill 0.12 opacity 0.4 }

// ==========================================
// 4. POINTS & INTERACTIVE CONTROLS
// ==========================================

// Standard plotted markers
class dot       { #ink point 9 }
class hollow    { #ink open point 9 }
class marker    { #coral point 11 }
class pin       { #indigo point 8 label-size 0.9 above }

// Draggable user handles
class handle    { #coral point 13 drag xy }
class handle-x  { #sky point 13 drag x }
class handle-y  { #emerald point 13 drag y }
class locked    { #slate point 9 drag none }

// Invisible clickable hitboxes (for buttons/triggers)
class hitbox    { fill 0 opacity 0 }

// ==========================================
// 5. LABELS & HUD TYPOGRAPHY
// ==========================================

// Clean floating text (hides the anchor dot)
class text      { #ink point 0 no-outline }
class title     { #ink point 0 no-outline label-size 1.6 }
class subtitle  { #slate point 0 no-outline label-size 1.1 }
class caption   { #slate point 0 no-outline label-size 0.85 }

// Light text for dark-mode / space / deep-sea scenes
class hud-light { #paper point 0 no-outline label-size 1.1 }
class title-light { #paper point 0 no-outline label-size 1.7 }

// Tag / badge style labels
class tag       { #indigo point 0 label-size 0.9 above }
class readout   { #ink point 0 no-outline label-size 1.05 right }

// ==========================================
// 6. EXPRESSION LIST / UTILITY MODIFIERS
// ==========================================

class debug     { #violet dashed width 1.5 opacity 0.7 }
class helper    { hidden secret }
class bg        { opacity 0.2 }
class muted     { opacity 0.45 }
