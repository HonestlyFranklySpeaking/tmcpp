// std/ui.tmcpp
// On-canvas interactive UI controls and HUD components for TMC++
import "./styles.tmcpp"

// Used by Stepper, CanvasSlider and ProgressBar.
clamp(z, lo, hi) = min(hi, max(lo, z))

// ==========================================
// 1. BUTTONS & TRIGGERS
// ==========================================

// Rectangular clickable button centered at C with size (w, h)
// action: Desmos action expression, e.g., count -> count + 1
component Button(C, w, h, text, action) {
  hw = w / 2
  hh = h / 2
  box = polygon([
    (C.x - hw, C.y - hh),
    (C.x + hw, C.y - hh),
    (C.x + hw, C.y + hh),
    (C.x - hw, C.y + hh)
  ]) . hidden
  box . #sky fill 0.16 width 2 click(action)
  C . #ink point 0 no-outline label "${text}"
}

// Pill / rounded-corner clickable button using SDF inequality
component PillButton(C, w, h, text, action) {
  rc = h / 2
  dx = abs(x - C.x) - (w / 2 - rc)
  dy = abs(y - C.y) - (h / 2 - rc)
  hit = hypot(max(dx, 0), max(dy, 0)) + min(max(dx, dy), 0) - rc <= 0
  hit . #indigo fill 0.18 width 2 click(action)
  C . #ink point 0 no-outline label "${text}"
}

// ==========================================
// 2. TOGGLES & STEPPERS
// ==========================================

// Binary switch bound to variable v (0 = OFF, 1 = ON)
component Toggle(C, w, h, text, v) {
  rc = h / 2
  dx = abs(x - C.x) - (w / 2 - rc)
  dy = abs(y - C.y) - (h / 2 - rc)
  track = hypot(max(dx, 0), max(dy, 0)) + min(max(dx, dy), 0) - rc <= 0
  track . #(rgb(5 + 220 * (1 - v), 150 + 60 * (1 - v), 105 + 120 * (1 - v))) fill 0.35 width 1.5 click(v -> 1 - v)

  knobX = C.x + (v - 0.5) * (w - h)
  (knobX, C.y) . #paper point 14 click(v -> 1 - v)
  (C.x + w / 2 + 0.35, C.y) . #ink point 0 no-outline right label "${text}"
}

// Minus / Value / Plus stepper bound to variable v clamped to [lo, hi]
component Stepper(C, w, h, text, v, step, lo, hi) {
  bw = h
  leftC = (C.x - w / 2 + bw / 2, C.y)
  rightC = (C.x + w / 2 - bw / 2, C.y)
  lhw = bw / 2
  lhh = h / 2

  // Minus button
  polygon([
    (leftC.x - lhw, leftC.y - lhh),
    (leftC.x + lhw, leftC.y - lhh),
    (leftC.x + lhw, leftC.y + lhh),
    (leftC.x - lhw, leftC.y + lhh)
  ]) . #slate fill 0.15 width 1.5 click(v -> max(lo, v - step))
  leftC . #ink point 0 no-outline label "-"

  // Plus button
  polygon([
    (rightC.x - lhw, rightC.y - lhh),
    (rightC.x + lhw, rightC.y - lhh),
    (rightC.x + lhw, rightC.y + lhh),
    (rightC.x - lhw, rightC.y + lhh)
  ]) . #slate fill 0.15 width 1.5 click(v -> min(hi, v + step))
  rightC . #ink point 0 no-outline label "+"

  // Center readout
  C . #ink point 0 no-outline label "${text}: ${v}"
}

// ==========================================
// 3. ON-CANVAS SLIDER & PROGRESS BAR
// ==========================================

// Horizontal draggable slider track from (x0, y0) of length len, mapping to [lo, hi]
// Exposes handle point H; read normalized value via norm or compute val externally
component CanvasSlider(x0, y0, len, lo, hi) {
  segment((x0, y0), (x0 + len, y0)) . #mist width 4
  H = (x0 + len * 0.5, y0) . #sky point 13 drag x
  norm = clamp((H.x - x0) / max(len, 1e-6), 0, 1)
  val = lo + (hi - lo) * norm
  segment((x0, y0), (x0 + len * norm, y0)) . #sky width 4
}

// Read-only progress / health bar centered at C, size (w, h), fill fraction p in [0, 1]
component ProgressBar(C, w, h, p) {
  pc = clamp(p, 0, 1)
  x0 = C.x - w / 2
  y0 = C.y - h / 2
  y1 = C.y + h / 2

  // Background frame
  polygon([
    (x0, y0),
    (x0 + w, y0),
    (x0 + w, y1),
    (x0, y1)
  ]) . #slate fill 0.1 width 1.5

  // Filled portion
  polygon([
    (x0, y0),
    (x0 + w * pc, y0),
    (x0 + w * pc, y1),
    (x0, y1)
  ]) . #emerald fill 0.75 width 0
}

// ==========================================
// 4. HUD CARDS & BADGES
// ==========================================

// Bordered HUD card container with header title at top-left
component HudCard(C, w, h, titleText) {
  hw = w / 2
  hh = h / 2
  polygon([
    (C.x - hw, C.y - hh),
    (C.x + hw, C.y - hh),
    (C.x + hw, C.y + hh),
    (C.x - hw, C.y + hh)
  ]) . #paper fill 0.85 width 1.5
  (C.x - hw + 0.3, C.y + hh - 0.45) . #ink point 0 no-outline right label-size 1.15 label "${titleText}"
}
