// std/ui.tmcpp
// On-canvas interactive UI controls and HUD components for TMC++
import "./styles.tmcpp"
import { roundedRect } from "./shapes.tmcpp"

// Used by Stepper, CanvasSlider and ProgressBar.
clamp(z, lo, hi) = min(hi, max(lo, z))

// ==========================================
// 1. BUTTONS & TRIGGERS
// ==========================================

// Rectangular clickable button centered at C with size (w, h)
// action: Desmos action expression, e.g., count -> count + 1
component Button(C, w, h, text, action) {
  hw = w / 2
  hh = h / 2
  box = polygon([
    (C.x - hw, C.y - hh),
    (C.x + hw, C.y - hh),
    (C.x + hw, C.y + hh),
    (C.x - hw, C.y + hh)
  ]) . hidden
  box . #sky fill 0.16 width 2 click(action)
  C . #ink point 0 no-outline center label "${text}"
}

// Pill-shaped clickable button
component PillButton(C, w, h, text, action) {
  polygon(roundedRect(C, w, h, h / 2)) . #indigo fill 0.18 width 2 click(action)
  C . #ink point 0 no-outline center label "${text}"
}

// ==========================================
// 2. TOGGLES & STEPPERS
// ==========================================

// Binary switch bound to variable v (0 = OFF, 1 = ON)
component Toggle(C, w, h, text, v) {
  polygon(roundedRect(C, w, h, h / 2)) . #(rgb(148 - 143 * v, 163 - 13 * v, 184 - 79 * v)) fill 0.9 width 0 click(v -> 1 - v)

  knobX = C.x + (v - 0.5) * (w - h)
  (knobX, C.y) . #paper point 14 click(v -> 1 - v)
  (C.x + w / 2 + 0.35, C.y) . #ink point 0 no-outline right label "${text}"
}

// Minus / Value / Plus stepper bound to variable v clamped to [lo, hi]
component Stepper(C, w, h, text, v, step, lo, hi) {
  bw = h
  leftC = (C.x - w / 2 + bw / 2, C.y) . hidden
  rightC = (C.x + w / 2 - bw / 2, C.y) . hidden
  lhw = bw / 2
  lhh = h / 2

  // Minus button
  polygon([
    (leftC.x - lhw, leftC.y - lhh),
    (leftC.x + lhw, leftC.y - lhh),
    (leftC.x + lhw, leftC.y + lhh),
    (leftC.x - lhw, leftC.y + lhh)
  ]) . #slate fill 0.15 width 1.5 click(v -> max(lo, v - step))
  leftC . #ink point 0 no-outline center label "−"

  // Plus button
  polygon([
    (rightC.x - lhw, rightC.y - lhh),
    (rightC.x + lhw, rightC.y - lhh),
    (rightC.x + lhw, rightC.y + lhh),
    (rightC.x - lhw, rightC.y + lhh)
  ]) . #slate fill 0.15 width 1.5 click(v -> min(hi, v + step))
  rightC . #ink point 0 no-outline center label "+"

  // Center readout
  C . #ink point 0 no-outline center label "${text}: ${v}"
}

// ==========================================
// 3. ON-CANVAS SLIDER & PROGRESS BAR
// ==========================================

// Horizontal slider drawn on the canvas, from (x0, y0) with length len, giving a value in [lo, hi].
// Drag the knob. Read the value as name.val (name.s is the position, 0 to 1).
component CanvasSlider(x0, y0, len, lo, hi) {
  s = 0.5 [0 : 1]
  val = lo + (hi - lo) * s
  segment((x0, y0), (x0 + len, y0)) . #mist width 4
  segment((x0, y0), (x0 + len * s, y0)) . #sky width 4
  (x0 + len * s, y0) . #sky point 13 drag x
}

// Read-only progress / health bar centered at C, size (w, h), fill fraction p in [0, 1]
component ProgressBar(C, w, h, p) {
  pc = clamp(p, 0, 1)
  x0 = C.x - w / 2
  y0 = C.y - h / 2
  y1 = C.y + h / 2

  // Background frame
  polygon([
    (x0, y0),
    (x0 + w, y0),
    (x0 + w, y1),
    (x0, y1)
  ]) . #slate fill 0.1 width 1.5

  // Filled portion
  polygon([
    (x0, y0),
    (x0 + w * pc, y0),
    (x0 + w * pc, y1),
    (x0, y1)
  ]) . #emerald fill 0.75 width 0
}

// ==========================================
// 4. HUD CARDS & BADGES
// ==========================================

// Bordered HUD card container with header title at top-left
component HudCard(C, w, h, titleText) {
  hw = w / 2
  hh = h / 2
  polygon([
    (C.x - hw, C.y - hh),
    (C.x + hw, C.y - hh),
    (C.x + hw, C.y + hh),
    (C.x - hw, C.y + hh)
  ]) . #slate fill 0.08 width 1.5
  (C.x - hw + 0.3, C.y + hh - 0.45) . #ink point 0 no-outline right label-size 1.15 label "${titleText}"
}
