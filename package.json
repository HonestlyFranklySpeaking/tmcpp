{
  "name": "tmcpp",
  "version": "0.2.0",
  "description": "TMC with Classes: a preprocessor for DesModder's Text Mode for Desmos, adding CSS-style classes, one-word styles, labels and slider shorthand, compiled live by a browser extension.",
  "keywords": [
    "desmos",
    "desmodder",
    "text-mode",
    "compiler",
    "transpiler",
    "dsl",
    "graphing",
    "browser-extension"
  ],
  "author": "Gordon Ji (https://github.com/IkeaSourPatches)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IkeaSourPatches/tmcpp.git"
  },
  "homepage": "https://github.com/IkeaSourPatches/tmcpp#readme",
  "bugs": {
    "url": "https://github.com/IkeaSourPatches/tmcpp/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tmcpp": "src/cli.js"
  },
  "files": [
    "src/",
    "docs/syntax.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:ext": "node tools/build-ext.js",
    "build:std": "node tools/build-std.js",
    "build:vscode": "node tools/build-vscode.js",
    "pack": "node tools/pack.js",
    "preview": "node tools/preview.js"
  },
  "dependencies": {
    "@desmodder/text-mode-core": "0.1.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1"
  }
}
