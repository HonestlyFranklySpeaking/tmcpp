{
  "name": "@ikeasourpatches/tmcpp",
  "version": "0.3.0",
  "description": "TMC with Classes: a preprocessor for DesModder's Text Mode for Desmos, with classes, one-word styles, components, conditionals, actions and libraries. Includes a CLI that compiles, checks and previews, and an MCP server for AI apps.",
  "keywords": [
    "desmos",
    "desmodder",
    "text-mode",
    "compiler",
    "transpiler",
    "dsl",
    "graphing",
    "browser-extension",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Gordon Ji (https://github.com/IkeaSourPatches)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IkeaSourPatches/tmcpp.git"
  },
  "homepage": "https://github.com/IkeaSourPatches/tmcpp#readme",
  "bugs": {
    "url": "https://github.com/IkeaSourPatches/tmcpp/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tmcpp": "src/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "docs/syntax.md",
    "docs/syntax/",
    "src/",
    "vendor/"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:ext": "node tools/build-ext.js",
    "build:std": "node tools/build-std.js",
    "build:vscode": "node tools/build-vscode.js",
    "pack": "node tools/pack.js",
    "preview": "node tools/preview.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
